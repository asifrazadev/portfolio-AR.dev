{
  "openapi": "3.0.0",
  "info": {
    "title": "Asif Raza Portfolio API",
    "version": "v1",
    "description": "Structured API layer for autonomous agents to access portfolio data programmatically."
  },
  "servers": [
    {
      "url": "https://asifraza.site"
    }
  ],
  "paths": {
    "/api/v1/projects": {
      "get": {
        "summary": "Get portfolio projects",
        "description": "Returns an array of projects from the database.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/v1/skills": {
      "get": {
        "summary": "Get technical skills",
        "description": "Returns a list of technical skills from the database.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "summary": "Get private profile information",
        "description": "Returns private profile data. Requires OAuth 2.0 Bearer token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthorized. Missing or invalid Bearer token."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}